{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.log",
      "docs/**",
      "tests/**",
      "functions/**",
      "**/*.md",
      "**/*.mq5",
      "firestore.rules",
      "firestore.rules.backup"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}